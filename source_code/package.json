{
    "name":  "pcshogar",
    "private":  true,
    "version": "1.8.9",
    "description":  "Control de Gastos",
    "versionCode": 201,
    "versionName": "1.8.9",
    "type":  "module",
    "main":  "electron/main.js",
    "build":  {
                  "appId":  "com.pcshogar.app",
                  "productName":  "PCSHogar",
                  "artifactName":  "PCSHogar_Setup_v${version}.${ext}",
                  "compression":  "maximum",
                  "icon":  "public/Icono_PCSHogar.png",
                  "publish":  [
                                  {
                                      "provider":  "generic",
                                      "url":  "https://pcshogar.es/app"
                                  }
                              ],
                  "directories":  {
                                      "output":  "dist_electron"
                                  },
                  "files":  [
                                "dist/**/*",
                                "electron/**/*"
                            ],
                  "win":  {
                              "target":  "nsis",
                              "icon":  "public/icon.ico"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  "always",
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "PCSHogar"
                           }
              },
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "lint":  "eslint .",
                    "preview":  "vite preview",
                    "electron:dev":  "concurrently \"vite\" \"wait-on http://localhost:5173 \u0026\u0026 electron .\"",
                    "electron:build":  "npm run build \u0026\u0026 electron-builder",
                    "android:build":  "node scripts/update-android-version.cjs \u0026\u0026 npm run build \u0026\u0026 npx cap sync android \u0026\u0026 cd android \u0026\u0026 gradlew assembleDebug \u0026\u0026 cd .. \u0026\u0026 node scripts/move-apk.cjs",
                    "build:all":  "npm run electron:build \u0026\u0026 npm run android:build"
                },
    "dependencies":  {
                         "@capacitor-community/file-opener":  "^6.0.1",
                         "@capacitor/filesystem":  "^6.0.1",
                         "@capacitor/share":  "^6.0.2",
                         "@capgo/capacitor-native-biometric":  "^6.0.4",
                         "react-is":  "^19.2.7"
                     },
    "devDependencies":  {
                            "@capacitor/android":  "^6.1.2",
                            "@capacitor/app":  "^6.0.3",
                            "@capacitor/browser":  "^6.0.6",
                            "@capacitor/cli":  "^6.1.2",
                            "@capacitor/core":  "^6.1.2",
                            "@eslint/js":  "^9.39.1",
                            "@types/node":  "^24.10.1",
                            "@types/react":  "^19.2.5",
                            "@types/react-dom":  "^19.2.3",
                            "@types/uuid":  "^10.0.0",
                            "@vitejs/plugin-react":  "^5.1.1",
                            "concurrently":  "^9.2.1",
                            "dropbox":  "^10.30.0",
                            "electron":  "^39.2.7",
                            "electron-builder":  "^26.0.12",
                            "eslint":  "^9.39.1",
                            "eslint-plugin-react-hooks":  "^7.0.1",
                            "eslint-plugin-react-refresh":  "^0.4.24",
                            "globals":  "^16.5.0",
                            "html2canvas":  "^1.4.1",
                            "idb":  "^8.0.3",
                            "jspdf":  "^2.5.1",
                            "lucide-react":  "^0.561.0",
                            "puppeteer":  "^25.2.1",
                            "react":  "^19.2.0",
                            "react-dom":  "^19.2.0",
                            "recharts":  "^3.6.0",
                            "typescript":  "~5.9.3",
                            "typescript-eslint":  "^8.46.4",
                            "uuid":  "^13.0.0",
                            "vite":  "^7.2.4",
                            "wait-on":  "^9.0.3"
                        }
}
